# build output
/go/muxscale
*.test
# local state
*.muxscale-backup-*
*.muxscale-tmp
.DS_Store
/sbom.cdx.json

# Release artefacts from packaging/build-linux-packages.sh
dist/

# Rust build output
rust/target/

# Node dependencies.
node_modules/

# Key and certificate material. Nothing here is tracked and nothing should be.
#
# `tailscale cert` writes a real Let's Encrypt keypair into whatever directory
# it is run from, and one landed in go/ during setup -- untracked, but `git add
# -A` would have staged it. The secret sweep in tools/security-scan.sh catches a
# committed private key, which is one step too late.
*.key
*.crt
*.pem
*.p8
*.p12
*.pfx

# The cf CLI's per-directory cache (account id and name).
.cloudflare/
